exam_data <- data.frame(
  Name=c("Ram","John","Priya","Anu"),
  Score=c(80,92,75,88),
  Attempts=c(1,2,1,3),
  Qualify=c("Yes","Yes","No","Yes")
)

print(exam_data)

# Extract Score
exam_data$Score

# Add column
exam_data$Grade <- c("B","A","C","B")

# Add row
newrow <- data.frame(
  Name="Kiran",
  Score=95,
  Attempts=1,
  Qualify="Yes",
  Grade="A"
)

exam_data <- rbind(exam_data,newrow)

# Sort
exam_data <- exam_data[order(-exam_data$Score),]

print(exam_data)

write.csv(exam_data,"exam_data.csv",row.names=FALSE)
