data(iris)

set.seed(100)

index <- sample(1:nrow(iris),
                0.8*nrow(iris))

train <- iris[index,]
test <- iris[-index,]

train$Species <- ifelse(train$Species=="setosa",1,0)
test$Species <- ifelse(test$Species=="setosa",1,0)

model <- glm(Species~Petal.Length+Petal.Width,
             data=train,
             family=binomial)

prob <- predict(model,
                test,
                type="response")

pred <- ifelse(prob>0.5,1,0)

table(Predicted=pred,
      Actual=test$Species)
